# Copy to .env (gitignored) and fill in. Generation-time only — the playing
# server never calls an LLM or a TTS engine, so it needs none of this.

# Any provider LiteLLM supports. Set the key matching OPSTATION_LLM_MODEL.
MISTRAL_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

OPSTATION_LLM_MODEL=mistral/mistral-large-latest

# Where the scenario bank and session records live. Defaults to ./data
# OPSTATION_DATA_DIR=/data
