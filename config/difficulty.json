{
  "_comment": "Everything that shapes pressure. Loaded at startup, shown on the admin page, and read by the scenario generator so a scenario is generated against the tunables it will be played with. Changing any key marked (validator) invalidates existing scenarios.",
  "tick_ms": 250,
  "failure_notice_cooldown_seconds": 30,
  "penalty_per_failed_task": 1,
  "penalty_per_wrong_answer": 1,
  "penalty_per_dont_know": 1,
  "read_cost_base_seconds": 2.0,
  "read_cost_words_per_second": 3.0,
  "read_cost_min_seconds": 4.0,
  "read_cost_max_seconds": 25.0,
  "task_slack_after_message_seconds": 10,
  "min_message_gap_seconds": 6,
  "read_budget_window_seconds": 60,
  "read_budget_phase1": 20,
  "read_budget_mid": 35,
  "read_budget_finale": 45,
  "challenge_task_clearance_seconds": 20,
  "challenge_blocks_doors": false,
  "show_pending_count": true,
  "radio_transcript_fallback": false,
  "generator_repair_attempts": 5,
  "volumes": {
    "messages_min": 55,
    "messages_max": 75,
    "threads_min": 4,
    "everyday_exchanges_min": 12,
    "everyday_exchanges_max": 18,
    "challenges_in_session": 3,
    "challenges_debrief": 3,
    "retractions_min": 2,
    "retractions_max": 3
  },
  "validator_keys": [
    "read_cost_base_seconds",
    "read_cost_words_per_second",
    "read_cost_min_seconds",
    "read_cost_max_seconds",
    "task_slack_after_message_seconds",
    "min_message_gap_seconds",
    "read_budget_window_seconds",
    "read_budget_phase1",
    "read_budget_mid",
    "read_budget_finale",
    "challenge_task_clearance_seconds",
    "volumes"
  ],
  "_radio_transcript_fallback_note": "false \u2014 audio failure voids the session; there is never a transcript fallback",
  "tts_engine": "piper",
  "_challenge_blocks_doors_note": "false \u2014 the challenge modal never locks the station canvas; time is never frozen and doors stay operable"
}
